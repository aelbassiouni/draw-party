{
  "name": "draw-party",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "58.0.24",
    "expo-audio": "58.0.12",
    "expo-build-properties": "58.0.12",
    "expo-dev-client": "58.0.19",
    "expo-keep-awake": "58.0.4",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.10.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "format": "prettier --write \"*.{ts,tsx,json,cjs}\" \".github/workflows/*.yml\" \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"*.{ts,tsx,json,cjs}\" \".github/workflows/*.yml\" \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "private": true
}
